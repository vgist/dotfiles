#!/usr/sbin/nft -f

define icmp_types = { echo-reply, destination-unreachable, time-exceeded }
define ndp_types = { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert }
define other_icmpv6_types = { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-reply, mld-listener-query, mld-listener-report, mld-listener-done, mld-listener-reduction, ind-neighbor-solicit, ind-neighbor-advert, mld2-listener-report }

table inet filter {
  chain base_filter {
    ip protocol icmp jump icmp_filter
    meta l4proto ipv6-icmp jump icmpv6_filter
  }
  chain icmp_filter {
    icmp type echo-request limit rate 10/second burst 20 packets counter accept
    icmp type $icmp_types counter accept
  }
  chain icmpv6_filter {
    icmpv6 type echo-request limit rate 10/second burst 20 packets counter accept
    icmpv6 type $ndp_types ip6 hoplimit 255 counter accept
    icmpv6 type $other_icmpv6_types counter accept
  }
}
